<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Only needed pre-scoped-storage (Android 9 and below); ignored by the system on Android 10+ -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.free_grind"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_silhouette" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="free_grind_chat_notifications_v2" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:theme="@style/Theme.free_grind.Starting"
            android:screenOrientation="sensorPortrait"
            android:exported="false" />

        <!--
          App disguise (see AppDisguise.kt): the launcher entry point lives on
          activity-alias components rather than MainActivity directly, so the
          launcher icon/name can be swapped by flipping which alias is
          enabled via PackageManager.setComponentEnabledSetting, without
          reinstalling or restarting the whole app. Exactly one of these
          should be enabled at a time; AppDisguise.applyDisguise() enforces
          that. The default alias starts enabled so a fresh install behaves
          like before this feature existed.
        -->
        <activity-alias
            android:name=".DisguiseDefaultAlias"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".DisguiseCalculatorAlias"
            android:targetActivity=".MainActivity"
            android:label="@string/disguise_name_calculator"
            android:icon="@mipmap/ic_launcher_calculator"
            android:roundIcon="@mipmap/ic_launcher_calculator_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".DisguiseNotesAlias"
            android:targetActivity=".MainActivity"
            android:label="@string/disguise_name_notes"
            android:icon="@mipmap/ic_launcher_notes"
            android:roundIcon="@mipmap/ic_launcher_notes_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".DisguiseWeatherAlias"
            android:targetActivity=".MainActivity"
            android:label="@string/disguise_name_weather"
            android:icon="@mipmap/ic_launcher_weather"
            android:roundIcon="@mipmap/ic_launcher_weather_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".FreeGrindFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
    <!-- ANDROID FS PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- ANDROID FS PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
</manifest>
