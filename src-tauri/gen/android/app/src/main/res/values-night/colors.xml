<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the "dark-bg" CSS variable in src/index.css so the native
         splash background doesn't visibly flash against the app's own
         background once the WebView paints. -->
    <color name="splash_background">#0F131A</color>
    <!-- Matches the "dark-text-muted" CSS variable in src/index.css —
         deliberately the muted/dimmer tone, not the near-white "dark-text"
         one, so the splash label isn't glaring against the dark background. -->
    <color name="splash_text">#96A2B6</color>
</resources>
